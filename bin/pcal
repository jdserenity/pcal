#!/usr/bin/env python3
import sys
from pathlib import Path

here = Path(__file__).resolve().parent # __file__ is bin/pcal, so .parent is bin/
repo_root = here.parent # one level up from bin/ is the repo root (the folder that contains the pcal/ package)
if (repo_root / "pcal" / "cli.py").exists():
  ROOT = repo_root # running from the git clone
else:
  ROOT = Path.home() / ".local" / "lib" / "pcal" # running from ~/.local/bin after install.sh

if str(ROOT) not in sys.path: # Think of sys.path as Python’s “where should I look for modules?” list.
  sys.path.insert(0, str(ROOT)) # Putting the package root at the front of the list means Python checks there first.

from pcal.cli import main

if __name__ == "__main__":
  raise SystemExit(main())
